# =============================================================================
# Consola de Licencias — Backend (server/)
# Copiar a server/.env y completar. NUNCA commitear .env
# =============================================================================

# --- Entorno ---
NODE_ENV=production
# Dominio público HTTPS de la consola (se usa en redirects y .well-known)
PUBLIC_URL=https://licencias.tudominio.com
PUBLIC_HOST=licencias.tudominio.com

# --- Servidor / TLS ---
HOST=0.0.0.0
PORT=8443
ENABLE_HTTPS=true
# Levanta además un puerto HTTP que redirige 301 a HTTPS
ALWAYS_REDIRECT=true
HTTP_PORT=8080
TLS_CERT_FILE=./certs/server.crt
TLS_KEY_FILE=./certs/server.key
# Detrás de nginx/Caddy/Cloudflare: true para leer X-Forwarded-Proto
TRUST_PROXY=true
# Orígenes extra permitidos para CORS, separados por coma
CORS_ORIGINS=

# --- Base de datos ---
DB_FILE=./data/drywall_console.db

# --- SEGURIDAD (OBLIGATORIO en producción, >= 16 caracteres) ---
# Firma de los access tokens JWT
JWT_SECRET=cambia-esto-por-48-bytes-aleatorios-base64url
# Cifra (AES-256-GCM) las llaves privadas RSA guardadas en la BD.
# SI LO CAMBIAS DESPUÉS DE EMITIR CLAVES, NO PODRÁS DESCIFRARLAS.
MASTER_KEY=cambia-esto-por-otra-clave-maestra-distinta

# --- Política de autenticación ---
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=7
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15
BCRYPT_ROUNDS=12
SECURE_COOKIES=true

# --- Criptografía ---
# Debe coincidir con KeyGenSecurity.kt del keygen Android (4096)
RSA_KEY_SIZE=4096

# --- Usuario administrador inicial ---
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@drywallpro.local
# Si lo dejas vacío se genera una contraseña fuerte y se imprime UNA vez al arrancar
BOOTSTRAP_ADMIN_PASSWORD=Cambia.Esta!2026
AUTO_SEED=true

# --- Web ---
# Carpeta del build de producción que este mismo proceso sirve
WEB_DIST=../web/dist

# ═════════════════════════════════════════════════════════════════════════════
# MÓDULOS PROFESIONALES: planos CAD, precios de distribuidores y AR
# ═════════════════════════════════════════════════════════════════════════════

# --- Planos vectoriales (DXF → DWG) ---
# Ruta al ejecutable de ODA File Converter (gratuito, Open Design Alliance).
# Si no se define, /api/cad/convert responde 501 y la web indica cómo hacerlo
# a mano (abrir el DXF en AutoCAD y GUARDAR COMO → DWG).
# Windows:  C:\Program Files\ODA\ODAFileConverter\ODAFileConverter.exe
# Linux:    /usr/bin/ODAFileConverter
CAD_CONVERTER_CMD=
# Carpeta de trabajo para las conversiones (se limpia tras cada trabajo).
CAD_WORK_DIR=./data/cad
# Carpeta vigilada por el plotter/reprografía. Vacío ⇒ descarga manual.
CAD_PLOT_DIR=
# Tamaño máximo del DXF aceptado (bytes). Por defecto 32 MB.
CAD_MAX_DXF_BYTES=33554432

# --- Catálogos de precios de distribuidores (proxy con lista blanca) ---
# Hosts autorizados, separados por coma. Si está vacío y PRICING_ALLOW_ANY_HOST
# es true, se permite cualquier host HTTPS público (nunca rangos privados).
PRICING_ALLOWED_HOSTS=api.distribuidor-ejemplo.com,tarifas.pladur-ejemplo.es
PRICING_ALLOW_ANY_HOST=true
PRICING_TIMEOUT_MS=12000
PRICING_MAX_RESPONSE_BYTES=4194304
PRICING_RATE_LIMIT=60

# --- Secretos de proveedores (los inyecta el proxy; NUNCA llegan al navegador) ---
# El nombre debe coincidir con `auth.secretRef` configurado en la web.
# Prefijos admitidos: SUPPLIER_, PRICING_, ERP_, DISTRIBUTOR_, CATALOG_
SUPPLIER_API_KEY=
SUPPLIER_TOKEN=
ERP_SERVICE_TOKEN=

# --- Asistencia remota por WebRTC (salas efímeras de señalización) ---
AR_ROOM_TTL_SECONDS=1800
AR_MAX_ROOMS=50
AR_MAX_SIGNALS=200
