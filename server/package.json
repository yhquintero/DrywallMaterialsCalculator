{
  "name": "drywall-license-console-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend profesional (HTTPS + RBAC) para el control de Keygen/Licencias de las apps DrywallPro Master y Keygen Pro",
  "main": "src/index.js",
  "scripts": {
    "start": "node --no-warnings src/index.js",
    "dev": "node --no-warnings --watch src/index.js",
    "bootstrap": "node --no-warnings tools/bootstrap.js",
    "test": "node --no-warnings --test \"tests/**/*.test.js\""
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.1"
  }
}
