# ─────────────────────────────────────────────────────────────────────────────
#  Consola de Licencias — backend Node (Express + node:sqlite)
#  Sin dependencias nativas compiladas: la imagen es pequeña y reproducible.
# ─────────────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS deps
WORKDIR /app
COPY server/package.json server/package-lock.json* ./
RUN npm ci --omit=dev --no-audit --no-fund || npm install --omit=dev --no-audit --no-fund

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production

# Usuario sin privilegios: la BD y los secretos nunca se tocan como root.
RUN addgroup -S console && adduser -S console -G console

COPY --from=deps /app/node_modules ./node_modules
COPY server/package.json ./package.json
COPY server/src ./src
COPY server/tools ./tools

# Volumen para la base de datos SQLite (persiste entre despliegues).
RUN mkdir -p /data && chown -R console:console /data /app
VOLUME ["/data"]

USER console
EXPOSE 8443

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8443)+'/api/public/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

CMD ["node", "--no-warnings", "src/index.js"]
