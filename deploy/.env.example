# =============================================================================
# Despliegue con Docker Compose (deploy/docker-compose.yml)
# Copia este archivo a deploy/.env y completa los valores. NUNCA lo commitees.
#
#   cd deploy && cp .env.example .env && docker compose up -d --build
# =============================================================================

# Dominio público de la consola (Caddy emitirá el certificado Let's Encrypt).
DOMAIN=licencias.tudominio.com
ACME_EMAIL=admin@tudominio.com

# ── Secretos OBLIGATORIOS ────────────────────────────────────────────────────
# Genera valores fuertes con:  openssl rand -base64 48
JWT_SECRET=
MASTER_KEY=

# ── Administrador inicial ────────────────────────────────────────────────────
# Si dejas la contraseña vacía, el servidor genera una y la imprime en el log
# la primera vez:  docker compose logs console-api
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@tudominio.com
BOOTSTRAP_ADMIN_PASSWORD=

# ── Criptografía ─────────────────────────────────────────────────────────────
# Debe coincidir con KeyGenSecurity.kt del keygen Android.
RSA_KEY_SIZE=4096
