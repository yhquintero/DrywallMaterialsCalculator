# Parámetros de proxy hacia la API de la Consola de Licencias.
# El backend escucha en HTTPS propio; si prefieres HTTP interno entre
# contenedores, arranca el servidor sin ENABLE_HTTPS y cambia el proxy_pass
# a http://console-api:8443 (nginx sigue terminando TLS de cara al cliente).

proxy_http_version 1.1;
proxy_set_header Host              $host;
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host  $host;
proxy_set_header X-Forwarded-Port  $server_port;
proxy_set_header Connection        "";

proxy_ssl_verify        off;
proxy_ssl_server_name   on;

proxy_connect_timeout 10s;
proxy_send_timeout    60s;
proxy_read_timeout    60s;

proxy_buffering    on;
proxy_buffer_size  16k;
proxy_buffers      8 16k;

# La API devuelve JSON/CSV: nada de cachear respuestas autenticadas.
proxy_hide_header X-Powered-By;
