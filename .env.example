# =============================================================================
# Drywall Materials Calculator — Variables de Entorno
# =============================================================================
# Copiar a .env (agregado en .gitignore) y llenar valores reales.
# NUNCA committear .env al repositorio.
# =============================================================================

# --- OpenCode / Modelos AI (OBLIGATORIO) ---
MODELS_DEV_API_KEY=sk-tu-api-key-de-models-dev

# --- GitHub MCP Server (OPCIONAL) ---
GITHUB_TOKEN=ghp_tu-github-token-personal

# --- Firma de APK :app (OBLIGATORIO para builds release) ---
DRYWALL_STORE_PASSWORD=contraseña-del-keystore
DRYWALL_KEY_ALIAS=alias-de-la-clave
DRYWALL_KEY_PASSWORD=contraseña-de-la-clave

# --- Firma de APK :keygen (OBLIGATORIO para builds release) ---
KEYGEN_STORE_PASSWORD=contraseña-del-keystore-keygen
KEYGEN_KEY_ALIAS=alias-de-la-clave-keygen
KEYGEN_KEY_PASSWORD=contraseña-de-la-clave-keygen
