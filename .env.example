# =============================================================================
# Drywall Materials Calculator — Variables de Entorno
# =============================================================================
# Copiar a .env (agregado en .gitignore) y llenar valores reales.
# NUNCA committear .env al repositorio.
# =============================================================================

# --- OpenCode / Modelos AI (OBLIGATORIO) ---
MODELS_DEV_API_KEY=sk-tu-api-key-de-models-dev

# --- GitHub MCP Server (OPCIONAL) ---
GITHUB_TOKEN=ghp_tu-github-token-personal

# --- Firma de APK :app (OBLIGATORIO para builds release) ---
DRYWALL_STORE_PASSWORD=contraseña-del-keystore
DRYWALL_KEY_ALIAS=alias-de-la-clave
DRYWALL_KEY_PASSWORD=contraseña-de-la-clave

# --- Firma de APK :keygen (OBLIGATORIO para builds release) ---
KEYGEN_STORE_PASSWORD=contraseña-del-keystore-keygen
KEYGEN_KEY_ALIAS=alias-de-la-clave-keygen
KEYGEN_KEY_PASSWORD=contraseña-de-la-clave-keygen

# --- Consola de Licencias: secretos del servidor (OBLIGATORIOS en producción) ---
# Generar con: openssl rand -base64 48
CONSOLE_JWT_SECRET=pega-aqui-un-secreto-de-48-bytes
CONSOLE_MASTER_KEY=pega-aqui-otro-secreto-distinto

# --- Consola de Licencias: dominio público HTTPS ---
CONSOLE_DOMAIN=licencias.tudominio.com
CONSOLE_PUBLIC_URL=https://licencias.tudominio.com

# --- Apps Android: URL de la consola (BuildConfig.LICENSE_CONSOLE_URL) ---
# Si queda vacío, las apps funcionan 100% offline con la clave empaquetada.
LICENSE_CONSOLE_URL=https://licencias.tudominio.com

# --- Solo el keygen: token para sincronizar con la consola ---
LICENSE_CONSOLE_TOKEN=

# --- Opcional: pinning de la clave pública (SHA-256 hex) ---
# Se lee en la consola → Claves de firma. Vacío ⇒ acepta la clave vigente.
LICENSE_CONSOLE_KEY_SHA256=

# --- Consola de Licencias: módulos profesionales (ver server/.env.example) ---
# Planos DXF→DWG (ODA File Converter) y catálogos de precios de distribuidores.
CAD_CONVERTER_CMD=
PRICING_ALLOWED_HOSTS=
SUPPLIER_API_KEY=
SUPPLIER_TOKEN=
ERP_SERVICE_TOKEN=
AR_ROOM_TTL_SECONDS=1800
